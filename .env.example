# Optional — copy to `.env` for local build or CI (never commit real secrets).

# Google Analytics 4 (injected in BaseLayout when set)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Open Graph / Twitter (optional)
# PUBLIC_TWITTER_SITE=@rustcheatorg
# PUBLIC_TWITTER_CREATOR=@rustcheatorg

# Schema.org Organization sameAs — comma-separated profile URLs
# PUBLIC_ORG_SAME_AS=https://x.com/example,https://discord.gg/wmFY3xVtwm

# IndexNow (optional; postbuild pings Bing/Yandex when INDEXNOW_KEY is set)
# INDEXNOW_KEY=your-indexnow-key-here
# INDEXNOW_HOST=rust-cheat.org
