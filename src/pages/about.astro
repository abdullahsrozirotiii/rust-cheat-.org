---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import PageShareLinks from '../components/PageShareLinks.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: content.title,
      description: content.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <PageShareLinks pathname="/about/" shareText={seo.title} />
  <LegalPage
    title="About Rust Cheat — Cheats Provider"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportCta="Email support team"
    homeCta="Return to homepage"
  />
</BaseLayout>
